# Where sign-ups go: any URL that accepts a JSON POST.
# For Google Sheets, this is the Apps Script web app URL plus ?key=<SECRET> (see README).
# Body sent: { email, site, cms, role, lang, source, createdAt }
WAITLIST_WEBHOOK_URL=

# Optional: sent as "Authorization: Bearer <value>" (not needed for Google Sheets,
# Apps Script can't read headers, so it uses ?key= instead).
WAITLIST_WEBHOOK_TOKEN=

# Without WAITLIST_WEBHOOK_URL, `next dev` appends sign-ups to .data/waitlist.jsonl
# and production returns 503, so no email is silently dropped.
